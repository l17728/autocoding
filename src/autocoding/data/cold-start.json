        }
      ]
    },
    {
      "id": "delegation",
      "topic": "受控委派与收口",
      "kind": "workflow",
      "category": "improvement",
      "content": "允许委派时，将范围、允许修改的文件、依赖、约束和交付标准写入自包含任务。只有互不冲突的工作才并发；PM 亲自检查产出与结果，不能只信子 Agent 自报。",
      "template": "任务：<目标>；范围：<目录/文件>；约束：<禁止事项>；验收：<可观察结果>；请返回变更与实际检查证据。",
      "sources": [
        {
          "kind": "local_user_instruction",
          "id": "da542b3c15d09224c730258055464f77286502856b7863bb5b38169e2ebea911"
