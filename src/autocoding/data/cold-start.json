        }
      ]
    },
    {
      "id": "resume",
      "topic": "接续上下文",
      "kind": "workflow",
      "category": "improvement",
      "content": "收到“继续”先恢复当前目标、项目文档、实际代码和未完成记录，保留已接受约束；不得把每次继续当成新项目或重做已完成工作。",
      "template": "先阅读 README 和实现状态，核对当前代码，再从最重要的未完成项接续。",
      "sources": [
        {
          "kind": "local_user_instruction",
