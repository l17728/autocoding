    },
    {
      "id": "design",
      "topic": "复杂改动先设计",
      "kind": "preference",
      "category": "communication",
      "content": "复杂功能先形成可执行规格：范围、数据流、接口、异常路径、用例和诊断点，再审查并实现。简单修复按复杂度缩小设计开销。",
      "template": "请给出规格与 SDD，明确边界、失败场景、日志及验收用例；审查无重大缺口后实施。",
      "sources": [
        {
          "kind": "local_user_instruction",
          "id": "09a9329495d523989fbabb6c90a4402322049388bf5349de17924efbb2b002d7"
        },
