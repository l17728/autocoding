{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:autocoding:contracts:v1",
  "title": "Autocoding core contracts",
  "$defs": {
    "taskCreate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "acceptance",
        "dependencies"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^task_[A-Za-z0-9_-]+$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "input_epoch",
        "text"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "input_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "task_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "completionReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "attempt",
        "lease_token",
        "head_sha",
        "artifact_refs"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "lease_token": {
          "type": "string",
          "minLength": 1
        },
        "head_sha": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "artifact_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "attempt",
        "head_sha",
        "checks"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "head_sha": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "acceptance_id",
              "passed",
              "artifact_ref"
            ],
            "properties": {
              "acceptance_id": {
                "type": "string"
              },
              "passed": {
                "type": "boolean"
              },
              "artifact_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
